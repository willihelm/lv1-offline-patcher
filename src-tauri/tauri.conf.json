{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LV1 Offline Patcher",
  "version": "0.1.0",
  "identifier": "io.github.willihelm.lv1-offline-patcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LV1 Offline Patcher",
        "width": 1500,
        "height": 900,
        "minWidth": 900,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Wilhelm Dück",
    "copyright": "Copyright (c) 2026 Wilhelm Dück",
    "license": "MIT",
    "category": "Music",
    "shortDescription": "Edit the patch of a Waves LV1 showfile offline",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
